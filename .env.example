# Copy to .env and fill in. Never commit .env.
# Anything left blank falls back to a stub, so the loop still runs.

# Supabase (Project Settings -> API). Blank = in-memory fallback store.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Connect -> Session pooler URI with the DB password filled in (for creating tables)
SUPABASE_DB_URL=

# Photon iMessage (Person A), from the Photon dashboard for your project:
#   PHOTON_API_KEY        project key, starts pho_sk_
#   PHOTON_PROJECT_ID     starts pho_prj_
#   PHOTON_WEBHOOK_SECRET signing secret of the webhook destination you register
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=

# Vision LLM (Person B)
ANTHROPIC_API_KEY=

# Parts search (Person B)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
SERPAPI_KEY=

# Google Calendar (Person C): path to a service-account JSON
GOOGLE_APPLICATION_CREDENTIALS=

# Demo
TECH_PHONE_1=
TECH_PHONE_2=
OFFER_TIMEOUT_SECONDS=60

# Public URL of this server (cloudflared/ngrok tunnel), used for photo links
PUBLIC_BASE_URL=

# Demo: customer location until intake reads one ("lat,lng"); blank = distance unknown
DEMO_CUSTOMER_LOCATION=
# Demo: customer phone shown on /phones before anyone texts
DEMO_CUSTOMER_PHONE=
