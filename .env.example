# Copy to .env and fill in. Never commit .env.
# Anything left blank falls back to a stub, so the loop still runs.

# Supabase (Project Settings -> API). Blank = in-memory fallback store.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Photon iMessage (Person A)
PHOTON_API_KEY=
PHOTON_NUMBER=

# Vision LLM (Person B)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# Parts search (Person B)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
SERPAPI_KEY=

# Google Calendar (Person C): path to a service-account JSON
GOOGLE_APPLICATION_CREDENTIALS=

# Demo
TECH_PHONE_1=
TECH_PHONE_2=
OFFER_TIMEOUT_SECONDS=60
